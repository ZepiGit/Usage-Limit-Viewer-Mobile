<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.UsageLimits" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/appearance_warm_dark_ground</item>
        <!--
          The widget picker shows the user the exact panel colour they are choosing. OEM
          "dark mode for third-party apps" (OxygenOS/ColorOS) is Force Dark, which repaints light
          fills dark, so a White swatch would preview as black; this theme is already dark, so
          opting out costs nothing and keeps the swatches honest.
        -->
        <item name="android:isLightTheme" tools:targetApi="q">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <attr name="usageLaunchGround" format="color" />

    <!-- The manifest fallback is Pure black. The overlay, not the system, draws the chosen icon. -->
    <style name="Theme.UsageLimits.App">
        <item name="usageLaunchGround">@color/appearance_pure_black_ground</item>
        <item name="android:windowBackground">?attr/usageLaunchGround</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">?attr/usageLaunchGround</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@android:color/transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="s">?attr/usageLaunchGround</item>
    </style>

    <style name="Theme.UsageLimits.App.WarmDark">
        <item name="usageLaunchGround">@color/appearance_warm_dark_ground</item>
    </style>

    <style name="Theme.UsageLimits.App.CoolGraphite">
        <item name="usageLaunchGround">@color/appearance_cool_graphite_ground</item>
    </style>

    <style name="Theme.UsageLimits.App.LightPaper">
        <item name="usageLaunchGround">@color/appearance_light_paper_ground</item>
        <item name="android:isLightTheme" tools:targetApi="q">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>
</resources>
