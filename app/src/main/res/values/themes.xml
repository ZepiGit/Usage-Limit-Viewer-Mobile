<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.UsageLimits" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#0F0F0E</item>
        <!--
          The widget picker shows the user the exact panel colour they are choosing. OEM
          "dark mode for third-party apps" (OxygenOS/ColorOS) is Force Dark, which repaints light
          fills dark, so a White swatch would preview as black; this theme is already dark, so
          opting out costs nothing and keeps the swatches honest.
        -->
        <item name="android:isLightTheme" tools:targetApi="q">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>
