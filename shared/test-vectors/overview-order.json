        { "id": "b", "createdAt": 1700000002000, "connection": "reconnectRequired", "reading": { "fetchedAt": 1799999400000, "status": "failed", "windows": [{ "id": "weekly", "scope": "global", "remainingPercent": 90, "exhausted": false, "resetAt": 1800003600000 }] } },
