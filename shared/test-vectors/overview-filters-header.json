        {"id":"near","createdAt":1700000000000,"connection":"connected","pauseUntil":null,"reading":{"fetchedAt":1799999940000,"status":"ok","windows":[{"id":"weekly","scope":"global","remainingPercent":20.01,"exhausted":false,"resetAt":1800057600000}]}}
