{
  "description": "How each provider's documented response becomes credit rows or usage windows, and which failures stay unknown rather than zero. Every expected value was worked out by hand from the vendor's documented response, not produced by running either parser. Android (ProviderPayloadMappingVectorsTest) and iOS (ProviderPayloadMappingVectorsTests) read this file directly; one section per provider, added as each parser lands.",
  "openrouterKeyWindow": [
    {
      "name": "a daily key limit reports the remaining share and resets at the next UTC midnight",
      "status": 200,
      "body": {"data": {"label": "sk-or-v1-a", "limit": 10, "limit_remaining": 2.5, "limit_reset": "daily", "usage_monthly": 7.5, "effective_budget": null}},
      "now": "2026-11-25T13:45:00Z",
      "expect": {"balances": [{"currency": "USD", "amount": "2.5", "total": "10", "usedPercent": 75, "resetAt": "2026-11-26T00:00:00Z"}]}
    },
    {
      "name": "a weekly key limit resets on Monday 00:00 UTC, not the end of the UTC week on Sunday",
      "status": 200,
      "body": {"data": {"limit": 40, "limit_remaining": 10, "limit_reset": "weekly", "effective_budget": null}},
      "now": "2026-11-22T23:59:00Z",
      "expect": {"balances": [{"currency": "USD", "amount": "10", "total": "40", "usedPercent": 75, "resetAt": "2026-11-23T00:00:00Z"}]}
    },
    {
      "name": "a monthly key limit read on 31 December resets on 1 January of the next year",
      "status": 200,
      "body": {"data": {"limit": 200, "limit_remaining": 50, "limit_reset": "monthly", "effective_budget": null}},
      "now": "2026-12-31T10:00:00Z",
      "expect": {"balances": [{"currency": "USD", "amount": "50", "total": "200", "usedPercent": 75, "resetAt": "2027-01-01T00:00:00Z"}]}
    },
    {
      "name": "a null limit_reset keeps the plain Key limit row and adds no reset",
      "status": 200,
      "body": {"data": {"limit": 50, "limit_remaining": 40.25, "limit_reset": null, "effective_budget": null}},
      "now": "2026-11-25T13:45:00Z",
      "expect": {"balances": [{"currency": "USD", "amount": "40.25", "total": "50", "usedPercent": 19.5, "resetAt": null}]}
    },
    {
      "name": "an unrecognised limit_reset invents no reset",
      "status": 200,
      "body": {"data": {"limit": 10, "limit_remaining": 5, "limit_reset": "yearly", "effective_budget": null}},
      "now": "2026-11-25T13:45:00Z",
      "expect": {"balances": [{"currency": "USD", "amount": "5", "total": "10", "usedPercent": 50, "resetAt": null}]}
    },
    {
      "name": "a remainder above the limit clamps the used share to 0",
      "status": 200,
      "body": {"data": {"limit": 10, "limit_remaining": 12.5, "limit_reset": "daily", "effective_budget": null}},
      "now": "2026-11-25T13:45:00Z",
      "expect": {"balances": [{"currency": "USD", "amount": "12.5", "total": "10", "usedPercent": 0, "resetAt": "2026-11-26T00:00:00Z"}]}
    },
    {
      "name": "a negative remainder clamps the used share to 100",
      "status": 200,
      "body": {"data": {"limit": 10, "limit_remaining": -2.5, "limit_reset": "monthly", "effective_budget": null}},
      "now": "2026-11-25T13:45:00Z",
      "expect": {"balances": [{"currency": "USD", "amount": "-2.5", "total": "10", "usedPercent": 100, "resetAt": "2026-12-01T00:00:00Z"}]}
    },
    {
      "name": "a zero limit stays a plain row with no bar and no reset",
      "status": 200,
      "body": {"data": {"limit": 0, "limit_remaining": 5, "limit_reset": "daily", "effective_budget": null}},
      "now": "2026-11-25T13:45:00Z",
      "expect": {"balances": [{"currency": "USD", "amount": "5", "total": "0", "usedPercent": null, "resetAt": null}]}
    },
    {
      "name": "an effective budget row is unchanged and carries no key-limit reset",
      "status": 200,
      "body": {"data": {"limit": 50, "limit_remaining": 40, "limit_reset": "monthly", "effective_budget": {"limit_usd": 20, "spend_usd": 5, "remaining_usd": 15, "reset_interval": "monthly", "resets_at": "2026-12-01T00:00:00.000Z"}}},
      "now": "2026-11-25T13:45:00Z",
      "expect": {"balances": [{"currency": "USD", "amount": "15", "total": "20", "usedPercent": 25, "resetAt": null}]}
    },
    {
      "name": "a limit whose remainder is missing stays unknown, never a zero balance",
      "status": 200,
      "body": {"data": {"label": "sk-or-v1-b", "limit": 10, "limit_reset": "daily", "effective_budget": null}},
      "now": "2026-11-25T13:45:00Z",
      "expect": {"error": "unknown"}
    }
  ],
  "vercelAiGateway": [
    {
      "name": "a balance and its token pass are decimal strings and become two rows, the pass carrying its reset",
      "status": 200,
      "body": {"balance": "95.50", "total_used": "4.50", "token_pass": {"remaining": "12.34", "resets_at": "2026-12-01T00:00:00.000Z"}},
      "expect": {"balances": [
        {"currency": "USD", "amount": "95.50", "total": null},
        {"currency": "USD", "amount": "12.34", "total": null, "resetAt": "2026-12-01T00:00:00Z"}
      ]}
    },
    {
      "name": "a null token pass leaves the single balance row",
      "status": 200,
      "body": {"balance": "95.50", "total_used": "4.50", "token_pass": null},
      "expect": {"balances": [{"currency": "USD", "amount": "95.50", "total": null}]}
    },
    {
      "name": "a token pass whose remaining is null adds no row and never a zero",
      "status": 200,
      "body": {"balance": "95.50", "total_used": "4.50", "token_pass": {"remaining": null, "resets_at": "2026-12-01T00:00:00.000Z"}},
      "expect": {"balances": [{"currency": "USD", "amount": "95.50", "total": null}]}
    },
    {
      "name": "an exhausted balance is a real zero and a missing total_used only drops the used figure",
      "status": 200,
      "body": {"balance": "0.00"},
      "expect": {"balances": [{"currency": "USD", "amount": "0.00", "total": null}]}
    },
    {
      "name": "a balance sent as a JSON number is refused rather than rounded",
      "status": 200,
      "body": {"balance": 95.5, "total_used": "4.50"},
      "expect": {"error": "unknown"}
    },
    {
      "name": "a token pass remaining sent as a JSON number is refused",
      "status": 200,
      "body": {"balance": "1.00", "total_used": "0", "token_pass": {"remaining": 12.34, "resets_at": "2026-12-01T00:00:00.000Z"}},
      "expect": {"error": "unknown"}
    },
    {
      "name": "a rejected key is invalid, never unknown",
      "status": 401,
      "body": {"error": "unauthorized"},
      "expect": {"error": "invalidKey"}
    },
    {
      "name": "a forbidden key is forbidden, and asks for the team id rather than a retry",
      "status": 403,
      "body": {"error": "forbidden"},
      "expect": {"error": "forbidden"}
    }
  ],
  "deepinfra": [
    {
      "name": "a negative stripe balance is money left to spend, and one live and one expired scoped credit give two rows",
      "status": 200,
      "body": {"uid": "u-1", "email": "a@example.com", "checklist": {"stripe_balance": -1234, "recent": 0, "limit": null, "suspend_reason": null, "scoped_credits": [
        {"name": "H100 grant", "granted_cents": 1000, "remaining_cents": 500, "granted_ts": 1760000000, "expires_ts": 1790000000, "expired": false, "covers_everything": false},
        {"name": "Expired grant", "granted_cents": 300, "remaining_cents": 300, "granted_ts": 1700000000, "expires_ts": 1710000000, "expired": true, "covers_everything": false}
      ]}},
      "expect": {"balances": [
        {"currency": "USD", "amount": "12.34", "total": null},
        {"currency": "USD", "amount": "5", "total": null}
      ]}
    },
    {
      "name": "a checklist without scoped credits is one prepaid row, and an exhausted one is a real zero",
      "status": 200,
      "body": {"uid": "u-1", "checklist": {"stripe_balance": 0, "recent": 0, "limit": 25, "suspend_reason": null}},
      "expect": {"balances": [{"currency": "USD", "amount": "0", "total": null}]}
    },
    {
      "name": "a positive stripe balance is money owed, so the row is a negative amount that stays visible",
      "status": 200,
      "body": {"uid": "u-1", "checklist": {"stripe_balance": 500, "recent": 4.5, "limit": null, "suspend_reason": null}},
      "expect": {"balances": [{"currency": "USD", "amount": "-5", "total": null}]}
    },
    {
      "name": "a null checklist stays unknown, never a zero balance",
      "status": 200,
      "body": {"uid": "u-1", "checklist": null},
      "expect": {"error": "unknown"}
    },
    {
      "name": "a reply without a checklist stays unknown, never a zero balance",
      "status": 200,
      "body": {"uid": "u-1", "email": "a@example.com"},
      "expect": {"error": "unknown"}
    },
    {
      "name": "a stripe balance that is not a number stays unknown",
      "status": 200,
      "body": {"uid": "u-1", "checklist": {"stripe_balance": "lots", "recent": 0, "limit": null, "suspend_reason": null}},
      "expect": {"error": "unknown"}
    },
    {
      "name": "a rejected key is invalid, never unknown",
      "status": 401,
      "body": {"detail": "Not authenticated"},
      "expect": {"error": "invalidKey"}
    },
    {
      "name": "a key without the account:read scope is forbidden, not a bad key",
      "status": 403,
      "body": {"detail": "Not enough permissions"},
      "expect": {"error": "forbidden"}
    }
  ],
  "tokenrouter": [],
  "ollama": [],
  "minimax": []
}
