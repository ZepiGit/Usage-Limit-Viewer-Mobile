{
  "description": "Kimi rate-window IDs are kimi-limit:<label>:<seconds>. Z.ai IDs are zai:<type>:<name>:<seconds-or-unknown>: type is the parser's uppercase type, name is the first provider name/label or the existing display label. Every text component is its exact UTF-8 bytes encoded as unpadded Base64URL, without case folding or Unicode normalization; existing provider-field trimming still applies. Kimi's weekly block keeps kimi-weekly. Colons separate components because they cannot appear in Base64URL. Equal base IDs get :2, :3, ... in provider order, with the first unsuffixed even in a shortened response. These suffixes keep IDs unique and the ID set stable on reorder, but cannot track individual entries with indistinguishable stable fields. Values, reset times and list positions never enter a base ID. Expected IDs and readings are hand-written.",
  "schema": "Each vector holds one actual provider payload and the complete expected windows in provider order; resetAt is epoch milliseconds, category uses the Swift spelling. Groups of original/reordered/shortened payloads keep stable identities while readings change.",
  "vectors": [
    {
      "name": "kimi-original",
      "provider": "kimi",
      "payload": {
        "usage": {"limit": 100, "used": 40},
        "limits": [
          {"name": "A", "windowSeconds": 18000, "detail": {"limit": 100, "remaining": 75, "resetTime": 1800000000}},
          {"label": "B", "window_seconds": 604800, "detail": {"limit": 100, "remaining": 0}}
        ]
      },
      "expected": [
        {"id": "kimi-weekly", "label": "Weekly", "category": "weekly", "usedPercent": 40, "periodSeconds": 604800, "resetAt": null, "exhausted": false},
        {"id": "kimi-limit:QQ:18000", "label": "A", "category": "fiveHour", "usedPercent": 25, "periodSeconds": 18000, "resetAt": 1800000000000, "exhausted": false},
        {"id": "kimi-limit:Qg:604800", "label": "B", "category": "weekly", "usedPercent": 100, "periodSeconds": 604800, "resetAt": null, "exhausted": true}
      ]
    },
    {
      "name": "kimi-reordered-new-readings",
      "provider": "kimi",
      "payload": {
        "usage": {"limit": 100, "used": 50},
        "limits": [
          {"label": "B", "window_seconds": 604800, "detail": {"limit": 100, "remaining": 50}},
          {"name": "A", "windowSeconds": 18000, "detail": {"limit": 200, "remaining": 100, "resetTime": 1800000100}}
        ]
      },
      "expected": [
        {"id": "kimi-weekly", "label": "Weekly", "category": "weekly", "usedPercent": 50, "periodSeconds": 604800, "resetAt": null, "exhausted": false},
        {"id": "kimi-limit:Qg:604800", "label": "B", "category": "weekly", "usedPercent": 50, "periodSeconds": 604800, "resetAt": null, "exhausted": false},
        {"id": "kimi-limit:QQ:18000", "label": "A", "category": "fiveHour", "usedPercent": 50, "periodSeconds": 18000, "resetAt": 1800000100000, "exhausted": false}
      ]
    },
    {
